    "db:migrate": "deno --env -A --node-modules-dir npm:drizzle-kit migrate"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "imports": {
    "@oak/oak": "https://deno.land/x/oak@v12.6.0/mod.ts",
    "@std/assert": "jsr:@std/assert@1",
    "@types/pg": "npm:@types/pg@^8.15.5",
    "drizzle-kit": "npm:drizzle-kit@^0.31.4",
    "drizzle-orm": "npm:drizzle-orm@^0.44.5",
    "pg": "npm:pg@^8.16.3"
    
  }
}